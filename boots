# ==================================
# HTACCESS - LITESPEED
# ==================================

Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Akses /event atau /events
# Menampilkan assets/user/index.php
RewriteRule ^events?$ assets/user/index.php [L]

# Izinkan file dan folder yang sudah ada
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

</IfModule>

# Lindungi file sensitif
<FilesMatch "^(\.env|\.htpasswd|\.gitignore)$">
Require all denied
</FilesMatch>
